{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tutor-catalog",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "routes": [{ "pattern": "tutor.adihnursyam.com", "custom_domain": true }],
  "durable_objects": {
    "bindings": [{ "name": "TUTOR_ADMIN_STATE", "class_name": "TutorAdminState" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TutorAdminState"] }],
  "vars": {
    "CF_AI_GATEWAY_ID": "tutor-ai-gateway",
    "AI_GATEWAY_BYOK": "true",
    "AI_MODEL": "google-ai-studio/gemini-2.5-flash",
    "AI_FALLBACK_MODELS": "openai/gpt-4o-mini",
    "AI_CACHE_TTL": "3600"
  }
}
