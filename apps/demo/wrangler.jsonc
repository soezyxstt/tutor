{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tutor-demo",
  "main": "src/worker.ts",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "demo.tutor.adihnursyam.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "CF_AI_GATEWAY_ID": "tutor-ai-gateway",
    "AI_GATEWAY_BYOK": "true",
    "AI_MODEL": "google-ai-studio/gemini-2.5-flash",
    "AI_FALLBACK_MODELS": "openai/gpt-4o-mini",
    "AI_CACHE_TTL": "3600"
  }
  // Uncomment after creating R2 bucket `tutor-assets`:
  // ,"r2_buckets": [
  //   {
  //     "binding": "MEDIA_BUCKET",
  //     "bucket_name": "tutor-assets"
  //   }
  // ]
}
