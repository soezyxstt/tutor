{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tutor-demo",
  "main": "src/worker.ts",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "demo.tutor.adihnursyam.com",
      "custom_domain": true
    }
  ]
}
