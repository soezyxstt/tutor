# Copy ke apps/<slug>/.dev.vars untuk testing AI live lokal via `wrangler dev`
# (File .dev.vars sudah di-ignore oleh .gitignore)

# Mode 1 (Rekomendasi): Cloudflare AI Gateway BYOK
CF_ACCOUNT_ID=your_cloudflare_account_id
CF_AI_GATEWAY_ID=tutor-ai-gateway
CF_AIG_TOKEN=your_cloudflare_ai_gateway_run_token
AI_GATEWAY_BYOK=true
AI_MODEL=google-ai-studio/gemini-2.5-flash
AI_FALLBACK_MODELS=openai/gpt-4o-mini

# Mode 2 (Opsional): Direct OpenAI-compatible key tanpa BYOK
# AI_GATEWAY_BYOK=false
# OPENAI_API_KEY=sk-...
