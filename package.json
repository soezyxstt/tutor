{
  "name": "tutor",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev:catalog": "pnpm --filter @tutor/app-catalog dev",
    "build:catalog": "pnpm --filter @tutor/app-catalog build",
    "catalog:generate": "node scripts/generate-catalog.mjs",
    "test": "node scripts/test.mjs",
    "dev:demo": "pnpm --filter @tutor/app-demo dev",
    "build:demo": "pnpm --filter @tutor/app-demo build",
    "preview:demo": "pnpm --filter @tutor/app-demo preview",
    "dev:starter": "pnpm --filter @tutor/app-starter dev",
    "build:starter": "pnpm --filter @tutor/app-starter build",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "validate": "node scripts/validate-course.mjs",
    "new-course": "node scripts/new-course.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.12"
  }
}
